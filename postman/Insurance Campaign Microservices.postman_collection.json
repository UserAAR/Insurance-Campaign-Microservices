    {
      "name": "Gateway - Create TSS Campaign",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('campaign is created by ROLE_ADMIN', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.data && body.data.id) { pm.collectionVariables.set('campaignId', body.data.id); }"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
