        <dependency>
            <groupId>com.casestudy.insurancecampaign</groupId>
            <artifactId>security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.casestudy.insurancecampaign</groupId>
            <artifactId>grpc-contract</artifactId>
            <version>${project.version}</version>
